#
#### Walls
#
# a wall
PROTO Wall [
      field SFVec3f wallSize 20 30 2
      field SFVec2f wallScale 10 10
]
{
   Transform {
        children [
                 Shape {
                       appearance Appearance {
                                  material Material { diffuseColor 0.5 0.4 0.3 }
                                  texture ImageTexture { url "im/rusty3.jpg" }
                                  textureTransform TextureTransform { scale IS wallScale }
                       }
                       geometry Box { size IS wallSize }
                 }
        ]
   }
} # end PROTO Wall
PROTO BrickWall [
      field SFVec3f wallSize 20 30 2
      field SFVec2f wallScale 10 10
]
{
   Transform {
        children [
                 Shape {
                       appearance Appearance {
                                  material Material { diffuseColor 0.5 0.4 0.3 }
                                  texture ImageTexture { url "im/Brick.gif" }
                                  textureTransform TextureTransform { scale IS wallScale }
                       }
                       geometry Box { size IS wallSize }
                 }
        ]
   }
} # end PROTO Wall



