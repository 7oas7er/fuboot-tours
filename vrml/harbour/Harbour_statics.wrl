# water sound
Sound {
                 minFront 1.0
                 minBack 1.0
                 maxFront 1.0
                 maxBack 1.0
                 spatialize FALSE
                 source AudioClip {
                       loop TRUE
                       url "../sound/water.wav"
                 }
}

