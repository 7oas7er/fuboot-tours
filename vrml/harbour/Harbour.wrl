#VRML V2.0 utf8
#
# World C   -   Harbour
#

WorldInfo {
        title "FU-Boot Tours"
        info [ "by Andi" ]
}

DEF tmpView Viewpoint {
        position 80 1.5 -80
        orientation 0 1 0 -1.3
}
DEF EntryView Viewpoint {
        position -70.3 11.625 6.4
        orientation 0 -1 0 4.5167
        description "User has just left submarine - view"
}
DEF OutOfSubView Viewpoint {
        position -70.3 11.625 6.4
        orientation 0 -1 0 4.5167
        description "User has just left submarine - view"
}
DEF MyEntryView Viewpoint {
        position -20 1.5 -3
        orientation 0 1 0 -1.3
        description "Entry view"
}
DEF tmpView Viewpoint {
        position 80 1.5 -80
        orientation 0 1 0 -1.3
}

NavigationInfo {
        type [ "WALK", "ANY" ]
        headlight FALSE
        speed 1
}


# The following will not be executed if this world is called from an external world.
Background {
    skyColor [
        0.1 .2 0.05,
        0.15 .2 .05,
        0.1 .2 0.1,
        0.05 .1 0.05,
        0.1 .1 0.05
    ]
    skyAngle [
        1.,
        1.40,
        1.50,
        1.58,
    ]
}

EXTERNPROTO Content [
        field    SFVec3f  location
        field    MFString contURL
        field    SFInt32  worth
        field    SFFloat  proxyShape
        eventOut SFInt32  found
] "collection.wrl#Content"
EXTERNPROTO Register [
        eventIn  SFInt32  found
        field    SFVec3f  location
        field    MFString pic1
        field    MFString pic2
] "collection.wrl#Register"
EXTERNPROTO Counter [
        eventIn  SFInt32  addScore
        field    SFVec3f  location
] "collection.wrl#Counter"

# HUD:
DEF Hud Collision {
        collide FALSE
        children [
                # Proximity sensor for notifying viewpoint changes
                DEF HudProximity ProximitySensor {
                        center 0 1.8 10
                        size 200 200 200
                }
                DEF HudGeometry Transform {                ##### - Licht nur wenn direkt geladen !!
                        children [
                                # HUD-Spotlights
                                Transform {
                                  translation 0 -2 10
                                  children [
                                    DEF hudLight SpotLight {
                                      ambientIntensity .9
                                      beamWidth        0.070796
                                      color            0.6 0.6 0.4
                                      cutOffAngle      0.385398
                                      direction        0 -0.2 -1.7
                                      location         0 5 5
                                      intensity        .6
                                      radius           80
                                    }
                                  ]
                                }
                                # HUD-Overheadlights
                                Transform {
                                  translation 0 50 10
                                  children [
                                    DEF OHLight PointLight {
                                         ambientIntensity 0
                                         intensity .5
                                         color 0.5 0.8 0.4
                                         radius 100
                                      }
                                  ]
                                }
                                 ### Registers:
                                 DEF Reg1 Register {
                                        location -.65 0.56 -1.5
                                        pic1 "im/pics/pic1.png"
                                        pic2 "im/pics/pic1_.png"
                                 }
                                 DEF Reg2 Register {
                                        location -.5 0.56 -1.5
                                        pic1 "im/pics/pic2.png"
                                        pic2 "im/pics/pic2_.png"
                                 }
                                 DEF Reg3 Register {
                                        location -.35 0.56 -1.5
                                        pic1 "im/pics/pic3.png"
                                        pic2 "im/pics/pic3_.png"
                                 }
                                 DEF Reg4 Register {
                                        location -.2 0.56 -1.5
                                        pic1 "im/pics/pic4.png"
                                        pic2 "im/pics/pic4_.png"
                                 }
                                 DEF Reg5 Register {
                                        location .2 0.56 -1.5
                                        pic1 "im/pics/pic5.png"
                                        pic2 "im/pics/pic5_.png"
                                 }
                                 DEF Reg6 Register {  # bottle
                                        location .35 0.56 -1.5
                                        pic1 "im/pics/pic6.png"
                                        pic2 "im/pics/pic6_.png"
                                 }
                                 DEF Reg7 Register {  # sword
                                        location .5 0.56 -1.5
                                        pic1 "im/pics/pic7.png"
                                        pic2 "im/pics/pic7_.png"
                                 }
                                 DEF Reg8 Register {  # ball
                                        location .65 0.56 -1.5
                                        pic1 "im/pics/pic8.png"
                                        pic2 "im/pics/pic8_.png"
                                 }
                                 DEF ScoreCount Counter { location 0 0.56 -1.5 }
                                 ### Bar:
                                 Transform {
                                        translation 0 0.75 -2
                                        children [
                                                Shape {
                                                        appearance Appearance {
                                                                material Material {
                                                                         diffuseColor 0 0 0
                                                                         emissiveColor 0 0 0
                                                                         transparency 0
                                                                }
                                                        }
                                                        geometry Box {
                                                                size 2.9 0.16 0
                                                        }
                                                }
                                        ]
                                 }
                        ]
                }
        ]
}
# Place the proximity center at the current viewpoint
ROUTE HudProximity.position_changed TO HudProximity.set_center
# Adjust the orientation of the Hud geometry
ROUTE HudProximity.orientation_changed TO HudGeometry.set_rotation
# Adjust the position of the Hud geometry
ROUTE HudProximity.position_changed TO HudGeometry.set_translation

Transform {
        scale .5 .25 .5
        children [
                Sound {
                        minFront 15.0
                        minBack 15.0
                        maxFront 30.0
                        maxBack 30.0
                        spatialize TRUE
                        source AudioClip {
                                url "../sound/water.wav"
                                startTime 1.0
                                stopTime  0.0
                                loop TRUE
                        }
                }
        ]
}

