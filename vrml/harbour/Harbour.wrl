#
# --  mine field
#
EXTERNPROTO AMine [
  field  SFInt32 power
  eventOut SFInt32 damage
] "Mine2.wrl#Mine"
# front line
  Transform {
        translation -12 .5 -9
        scale .2 .2 .2
        children [ DEF Miny1 AMine { power 450 } ]
  }
  Transform {
        translation -6 .5 -11
        scale .2 .2 .2
        children [ DEF Miny2 AMine { power 450 } ]
  }
  Transform {
        translation 0 .5 -9
        scale .2 .2 .2
        children [ DEF Miny3 AMine { power 450 } ]
  }
  Transform {
        translation 6 .5 -11
        scale .2 .2 .2
        children [ DEF Miny4 AMine { power 450 } ]
  }
  Transform {
        translation 12 .5 -9
        scale .2 .2 .2
        children [ DEF Miny5 AMine { power 450 } ]
  }
# middle line
