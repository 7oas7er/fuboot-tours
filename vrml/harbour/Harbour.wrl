        translation -15.5 .5 -19
        scale .2 .2 .2
        children [ DEF Miny6 AMine { power 450 } ]
  }
  Transform {
        translation -9.5 .5 -21
        scale .2 .2 .2
        children [ DEF Miny7 AMine { power 450 } ]
  }
  Transform {
        translation -3.5 .5 -19
        scale .2 .2 .2
        children [ DEF Miny8 AMine { power 450 } ]
  }
  Transform {
        translation 2.5 .5 -21
        scale .2 .2 .2
        children [ DEF Miny9 AMine { power 450 } ]
  }
  Transform {
        translation 9.5 .5 -19
        scale .2 .2 .2
        children [ DEF Miny10 AMine { power 450 } ]
  }
  Transform {
        translation 15.5 .5 -21
        scale .2 .2 .2
        children [ DEF Miny11 AMine { power 450 } ]
  }
# back line
  Transform {
        translation -12 .5 -31
        scale .2 .2 .2
        children [ DEF Miny12 AMine { power 450 } ]
  }
  Transform {
        translation -6 .5 -29
        scale .2 .2 .2
        children [ DEF Miny13 AMine { power 450 } ]
  }
  Transform {
        translation 0 .5 -31
        scale .2 .2 .2
        children [ DEF Miny14 AMine { power 450 } ]
  }
  Transform {
        translation 6 .5 -29
        scale .2 .2 .2
        children [ DEF Miny15 AMine { power 450 } ]
  }
  Transform {
        translation 12 .5 -31
        scale .2 .2 .2
        children [ DEF Miny16 AMine { power 450 } ]
  }




