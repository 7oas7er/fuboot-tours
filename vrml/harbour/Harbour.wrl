        eventOut SFInt32 foundBony
        eventOut SFInt32 foundBottles
        eventOut SFInt32 foundBall
] "Lab.wrl#Lab"
Transform {
    translation 62.75 13.5 1
    rotation 0 1 0 3.1459
    scale 4 3 4
    children [ DEF Laby Lab {} ]
}

# static parts of harbour
Inline { url "Harbour_statics.wrl" }



