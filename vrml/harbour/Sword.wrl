#VRML V2.0 utf8

DEF Sword Billboard { 
        axisOfRotation 1 1 0 # Rotate about Y (up) axis 
        bboxSize        1 1 1
	children [	
    	    DEF CI CoordinateInterpolator {
      		key [ 0.0, 0.5, 1.0 ]
      		keyValue [ 1 0 -1, -1 0 -1, 1 0 1, -1 0 1 ]
      		keyValue [ 1.5 0 -1.5, -1.5 0 -1.5, 1.5 0 1.5, -1.5 0 1.5 ]
      		keyValue [ 1 0 -1, -1 0 -1, 1 0 1, -1 0 1 ]
    	    }    
            Shape { 
           	appearance Appearance { 
           	   texture ImageTexture { url "im/sword.gif" }
        	   textureTransform TextureTransform { rotation 1.5708 }
           	} 
	        geometry Box { size 2.5 .5 0 }
      	    }
	]
}
