#VRML V2.0 utf8

# This is a pile of rocks

Group {
	
	children [
		DEF Entry Viewpoint {
            position 0 0 5
            orientation 0.0 1.0 0.0 0.52
            description "Entry View"
        },
		# a rock proto
		DEF Rock Transform {
			translation	0 0 0
			children [
				Shape {
					appearance
					Appearance {
		    			material
						DEF Defmaterial Material {}
		    			texture
						ImageTexture {
			    			url	"sand.png"
						}
					}
	    			geometry Sphere {
						radius 3
					}
				}
			]
		}
		DEF	SecondRock Transform {
			translation	3 -0.5 0
			scale 0.5 0.5 0.5
			children [
				USE	Rock
			]
		}
	]
}

