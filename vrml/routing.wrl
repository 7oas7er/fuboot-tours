#VRML V2.0 utf8





DEF InfoCenters Transform {
	translation 0 835 0
	scale 15 15 15
	rotation 0 1 0 1
	children [
		Inline {
			url	"./objekte/Infocenter/infocenter.wrl"	   # OK
		}
	]
}	# END OF INFORMATION CENTER (SET)

# Set the derrick (drillisland ;-) )

DEF	drillisland	Transform {
	translation	1001 0 0
	scale 20 20 20
	rotation 0 0 1 -1.5
	children [
		Inline {
			url	"./objekte/bohrinsel/bohrinsel.wrl"			# OK
		}
	]
}	# END OF BOHRINSEL (SET)


# Set a submarine wreck

DEF	submarinewreck Transform {
	translation	0 -990 0
	scale 30 30 30
	rotation 1 0 0 1
	children [
		Inline {
			url	"./objekte/wreck/u-broot.wrl"				# OK
		}
	]
}	# END OF SUBMARINE WRECK  (SET)

# Set another broken submarine

DEF	submarine2wreck Transform {
	translation	-1000 0 0
	scale 30 30 30
	rotation 1 0 0 0.5
	children [
		Inline {
			url	"./objekte/wreck/u-brootbroken.wrl"			# OK
		}
	]
}	# END OF SUBMARINE WRECK  (SET)

# Set a pile of barrrels

DEF	pileofbarrels Transform {
	translation	0 0 1000
	scale 10 10 10
	rotation 0 1 0 1
	children [
		Inline {
			url	"./objekte/barrels/pileOfBarrel.wrl"		# OK	
		}
	]
}	# END OF BARRELS  (SET)
 
