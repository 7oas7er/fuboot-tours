	translation	200 842 100
	scale 5 5 5
	rotation 0 1 0 1
	children [
		Inline {
			url	"./objekte/barrels/pileOfBarrel.wrl"		# OK
		}
	]
}	# END OF BARRELS  (SET)

DEF	pileofbarrels3 Transform {
	translation	0 843 -250
	scale 5 5 5
	rotation 0 1 0 1
	children [
		Inline {
			url	"./objekte/barrels/pileOfBarrel.wrl"		# OK
