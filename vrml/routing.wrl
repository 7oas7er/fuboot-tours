}	# END OF BARRELS  (SET)

# Set a pile of rocks

DEF	pileofrocks Transform {
	translation	0 835 300
	scale 10 10 10
	rotation 0 1 0 1
	children [
		Inline {
			url	"./objekte/rocks/rocks.wrl"
		}
	]
}	# END OF ROCKS  (SET)

DEF	anotherpileofrocks Transform {
	translation	-800 0 600
	scale 10 10 10
	rotation 1 0 0 1
	children [
		Inline {
			url	"./objekte/rocks/rocks.wrl"
		}
	]
}	
DEF rocks1 Transform	{
	translation	-50 0 0
	scale .8 .8 .8
	children [
		USE anotherpileofrocks
	]	
}







# END OF ROCKS  (SET)


# versunkenes Labor:

DEF	SunkenLab Transform {
	translation	0 700 700 
	rotation 1 0 0 .75
	scale 4.2 4.2 4.2
       children [
		Inline { url "./objekte/Labor/sunkenLab.wrl" }
	]
}

# mehrere Fische:


# Anfang 01: Fischschwaerme, die um die Kugel schwimmen/ rotieren
Transform {
	rotation 1 0 0 1
        children [
		Inline { url "./objekte/Fische/fish_rotate.wrl" }
	]
}
Transform {
	rotation 1 0 0 3
        children [
		Inline { url "./objekte/Fische/fish_rotate.wrl" }
	]
}
Transform {
	rotation 0 0 1 2
        children [
		Inline { url "./objekte/Fische/fish_rotate.wrl" }
	]
}
Transform {
	translation	0 50 0
        children [
		Inline { url "./objekte/Fische/fish_rotate.wrl" }
	]
}
Transform {
	rotation 0 1 0 1
	translation	0 -30 0
        children [
		Inline { url "./objekte/Fische/fish_rotate.wrl" }
	]
}
# Ende 01

# Anfang 02: Fischschwarm, der um die Kugel schwimmt/ rotiert
Transform {
	rotation 0 1 0 -1
    children [
		Inline { url "./objekte/Fische/fish_rotate2.wrl" }
	]
}


