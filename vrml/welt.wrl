	field SFRotation Ruder 0 1 0 0
	field SFRotation Neigung 1 0 0 0
	field SFRotation oldNeigung 1 0 0 -0.55

	field SFBool idle FALSE

	directOutput TRUE
	
	url "javascript:
	
	function initialize() {
		myNav.set_bind = TRUE;
		Fahrt = new SFRotation(1, 0, 0, 0);
		oldRot = new SFRotation(0, 0, 0, 0);
		Ruder = new SFRotation(0, 1, 0, 0);
		Neigung = new SFRotation(1, 0, 0, 0);
		oldNeigung = new SFRotation(1, 0, 0, -0.55);
		Hoehe = clampAboveSeabed(Hoehe);
		Position.y = Hoehe;
		myHUD.set_translation = Position;
		s = new MFFloat(-0.001, -0.0007, -0.0005, -0.0004, -0.00036, -0.00033, 0, 0.00033, 0.00036, 0.0004, 0.0005, 0.0007,  0.001);
