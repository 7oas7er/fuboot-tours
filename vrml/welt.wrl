	function set_idle_rudder(value) {
		if (value == TRUE) {
			if (idle == FALSE) {
				setTex(myRuder_Textur, 'texturen/ruderidle.png');
				idle = TRUE;
			}
			else if (idle == TRUE) {
				setTex(myRuder_Textur, 'texturen/ruder.png');
				idle = FALSE;
			}
		}
	}

