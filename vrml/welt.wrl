#VRML V2.0 utf8                                                                                                        


# Das UBoot allerdings mit Rotationsmittelpunkt im Kugelzentrum
DEF	Welt Transform {
	children [
	
		DEF Nav NavigationInfo{ 
	headlight FALSE 
	# Contact used ["TRUE"] to disable walk; X_ITE needs NONE so HUD TouchSensors get the mouse.
	type ["NONE"]
}

DEF UBoot Transform {
	children [
		 
		 # Moving Background
	#	 DEF Background Transform {
	#				translation 0 200 0
	#				scale 150 150 150
	#				children [
	#					Inline {
	#						url	"background.wrl"
	#					}
	#	 			]
	#			}

		# Alles wird von einem ProxySensor umfasst
									
		# HUD on +Y radial (Navigator Position.y). After Untergrund ~180 deg
		# flip, +Y seabed is near y~798; start just above, pitched down so
		# ground fills the view ahead and below.
		DEF HUD Transform {
  			translation 0 835 0
			rotation 1 0 0 -0.55
			
			children [
				

				Transform {
					translation	0 0 -11
  					children [
    					DEF Scheinwerfer SpotLight {
							radius	1
							cutOffAngle 0.4
    					}
  					]
				}
				Transform {
					translation	0 100 0
					rotation 1 0 0 0.3
					children [
    					DEF Scheinwerfer2 SpotLight {
							#radius	1000
							intensity 1
							cutOffAngle 3.14
							direction 0 -1 0
    					}
  					]
				}
				# Der Blick aus dem HUD
				DEF Kapitaen Transform {
					children [
						Viewpoint { 
							description "Blick voraus"
							position 0 0 0
						}
					]
				}	
											
  				
						DEF HeadUpDisplay Transform {
    						translation 0 0.6 -10
							rotation 1 0 0 1.571
    						children [
													
        
        								
	
						DEF Konsole Transform {
    						scale 1.35 1 1.35
    						translation 1.25 0 3.75
