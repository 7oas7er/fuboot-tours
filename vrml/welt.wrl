	function trunc(value) {
		return Math.round(value*10000)/10000;
	}
	
	
	function setTex(node, file) {
		try {
			node.url = new MFString(file);
		} catch (e) {
			node.url = file;
		}
	}

	function isOn(value) {
		return (value == TRUE) || (value == true);
	}

