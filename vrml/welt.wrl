	// Rotate local +Y by UBoot orientation to get world radial direction,
	// then keep Hoehe above the seabed surface in that direction.
	function radialUp() {
		var ux = oldRot.x, uy = oldRot.y, uz = oldRot.z;
		var len = Math.sqrt(ux*ux + uy*uy + uz*uz);
		if (len < 1e-8) return new SFVec3f(0, 1, 0);
		ux /= len; uy /= len; uz /= len;
		var ca = Math.cos(oldRot.angle), sa = Math.sin(oldRot.angle);
		// local (0,1,0)
		var vx = 0, vy = 1, vz = 0;
		var dot = uy;
		var cx = uz, cy = 0, cz = -ux;
		return new SFVec3f(
			vx*ca + cx*sa + ux*dot*(1-ca),
			vy*ca + cy*sa + uy*dot*(1-ca),
			vz*ca + cz*sa + uz*dot*(1-ca)
		);
	}
	function seabedRadius(dir) {
		var best = -1, bestR = 800;
		var n = seabedPts.length;
		for (var i = 0; i < n; i++) {
			var p = seabedPts[i];
			var pr = Math.sqrt(p.x*p.x + p.y*p.y + p.z*p.z);
			if (pr < 1) continue;
			var d = (p.x*dir.x + p.y*dir.y + p.z*dir.z) / pr;
			if (d > best) {
				best = d;
				bestR = pr;
			}
		}
		return bestR;
	}
	function clampAboveSeabed(h) {
		var floor = seabedRadius(radialUp()) + MinClearance;
		if (h < floor) return floor;
		return h;
	}
	function set_fraction (frac, tm) {
		
		Fahrt.angle = aktuelleGeschwindigkeit;
		aktuelleGeschwindigkeit = aktuelleGeschwindigkeit + 1/30*(Fahrtgeschwindigkeit - aktuelleGeschwindigkeit);

		if (collision == TRUE) {
			alert();
		}
		else {
			if (trunc(aktuelleGeschwindigkeit) != 0) {
				Ruder.angle = aktuellesRuder;
				aktuellesRuder = aktuellesRuder + 1/10*(Ruderanschlag - aktuellesRuder);
				myUBoot.set_rotation = Ruder.multiply(Fahrt.multiply(oldRot));
				oldRot = myUBoot.rotation_changed;

				if (((gesamtNeigung < -0.4) && (Neigungswinkel > 0)) || ((gesamtNeigung > 0.4) && (Neigungswinkel < 0)) || ((gesamtNeigung >= -0.4) && (gesamtNeigung <= 0.4))){
					Neigung.angle = aktuelleNeigung;
					aktuelleNeigung = aktuelleNeigung +1/10*(Neigungswinkel - aktuelleNeigung);
					gesamtNeigung = gesamtNeigung + aktuelleNeigung;
					myHUD.set_rotation = Neigung.multiply(oldNeigung);
					oldNeigung = myHUD.rotation_changed;
				}
			}
			else {
				Ruder.angle = aktuellesRuder;
				aktuellesRuder = aktuellesRuder + 1/30*(0 - aktuellesRuder);
				myUBoot.set_rotation = Ruder.multiply(Fahrt.multiply(oldRot));
				oldRot = myUBoot.rotation_changed;
				if ((gesamtNeigung >= -0.4) && (gesamtNeigung <= 0.4)){
					Neigung.angle = aktuelleNeigung;
					aktuelleNeigung = aktuelleNeigung +1/30*(0 - aktuelleNeigung);
					gesamtNeigung = gesamtNeigung + aktuelleNeigung;
					myHUD.set_rotation = Neigung.multiply(oldNeigung);
					oldNeigung = myHUD.rotation_changed;
				}
			}

		
			Hoehe = Hoehe - (gesamtNeigung*aktuelleGeschwindigkeit*1000);
			Hoehe = clampAboveSeabed(Hoehe);
			Position.y = Hoehe;
			myHUD.set_translation = Position;
		}
	}
	"
}


]
}
