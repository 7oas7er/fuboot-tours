        						Shape {
        							appearance Appearance {
            							texture ImageTexture {
											url "texturen/konback.png"
										}
        							}
        							geometry Box {
										size 6.41 0.1 0.96
									}
        						}

								DEF Antriebssteuerung Transform {
									# Lift slightly so speed cells sit above konback and receive picks.
									translation	-2.5 0.2 -0.02
