#VRML V2.0 utf8

# a pile of barrels

Group {
	children [
		DEF Entry Viewpoint {
            position 0 0 5
            orientation 0.0 1.0 0.0 0.52
            description "Entry View"
        },
		Transform {
        	translation 0 -0.7 0
			rotation 0 0 1 1.578
        	children [ Inline { url "barrel.wrl" } ]
		}      
		Transform {
        	translation 0 0 2
			rotation 0 0 0 0
        	children [ Inline { url "barrel.wrl" } ]
		}      
		Transform {
    		    translation 2 0 2
				rotation 1 0 0 -0.7
    			 children [ Inline { url "barrel.wrl" } ]
		}    
	]
}  