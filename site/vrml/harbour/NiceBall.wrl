#VRML V2.0 utf8
#
# Content for a box.
#

# Ball to be discovered
DEF Ball Transform {
    children [
             Shape {
                                appearance Appearance {
                                        material Material {
                                                emissiveColor 0.454 0.494 0
                                        }
                                        texture ImageTexture { url "im/weirdButColourful.jpg" }
                                }
                                geometry Sphere {
                                           radius 0.2
                                }
             }
 #            DEF Touchy TouchSensor {}
    ]
}

DEF Timey TimeSensor { cycleInterval 10.0 loop TRUE startTime 0 }
DEF Rotty OrientationInterpolator {
    key [ 0.0, 0.5, 1.0 ]
    keyValue [ 1 1 1 0.0, 1 1 1 3.14, 1 1 1 6.28 ]
}

#ROUTE Touchy.touchTime TO Timey.set_startTime
ROUTE Timey.fraction_changed TO Rotty.set_fraction
ROUTE Rotty.value_changed TO Ball.set_rotation