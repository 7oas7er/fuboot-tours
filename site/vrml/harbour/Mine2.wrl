#VRML V2.0 utf8
#
# Mine.
#

Viewpoint {
    position 0 2 20
    description "Entry view"
}

# Mine to be discovered
PROTO Mine [
      field    SFInt32 power 500
      eventOut SFInt32 damage
]
{
      DEF MineHolder Transform { }
      DEF Disappeary Script {
             field    SFNode  miney Transform {
                 children [
                     Shape {
                                        appearance DEF MetalApp Appearance {
                                                material Material { emissiveColor 0.454 0.234 0 }
                                                texture ImageTexture { url "im/metalGrip.jpg" }
                                                textureTransform TextureTransform { scale 4 4 }
                                        }
                                        geometry Sphere {
                                                   radius 2
                                        }
                     }
                     DEF Rods Group {
                           children [
                                     DEF Rod Transform {
                                         scale 17.5 1 1
                                         children [
                                                  Shape {
                                                        appearance USE MetalApp
                                                        geometry Sphere {
                                                                   radius .2
                                                        }
                                                  }
                                         ]
                                     }
                                     Transform {
                                               rotation 0 1 1 3.14
                                               children [  USE Rod  ]
                                     }
                                     Transform {
                                               rotation 1 1 0 3.14
                                               children [  USE Rod  ]
                                     }
                                     Transform {
                                               rotation 1 0 1 3.14
                                               children [  USE Rod  ]
                                     }
                           ]
                     }
                     Transform {
                               rotation 1 1 1 3.14
                               children [  USE Rods  ]
                     }
                     DEF Colly Collision {
                                        collide TRUE
                                        proxy Shape { geometry Sphere { radius 10 } }
                     }
                     DEF Touchy TouchSensor {}
                 ]
             } # end SFNode miny
             field    SFInt32 power IS power
             eventIn  SFTime  explode
             eventOut SFTime  startExplosion
             eventOut SFInt32 damage IS damage
             eventOut MFNode  createMine
             eventOut MFNode  deleteMine
             directOutput TRUE
             url ["javascript:
                 function initialize (v, ts) {
                          createMine = new MFNode;
                          createMine[0] = miney;
                 }
                 function explode ( t ) {
                          startExplosion = t;
                          damage = -power;
                          deleteMine = new MFNode;
                          deleteMine[0] = miney;
                 }
             "]
      } # end Script Disappeary

      # Ball of Fire
      DEF GreatBallOfFire Transform {
           scale .1 .1 .1
           children [
                  Shape {
                        appearance DEF MetalApp Appearance {
                                material Material { emissiveColor 0.454 0.234 0 }
                                texture ImageTexture { url "im/flame.jpg" }
                                textureTransform TextureTransform { scale 2 2 }
                        }
                        geometry Sphere {
                                   radius 1
                        }
                  }
           ]
      }
      Transform {				# sound
        scale 5 1 5
        children [
                Sound {
                        source DEF Clippy AudioClip {
                                url "../sound/splash.wav"
                                startTime -1
                                loop FALSE
                        }
                }
        ]
      }
      DEF ExplosionTimer TimeSensor { cycleInterval .5 loop FALSE startTime -1 }
      DEF Plosie PositionInterpolator {
            key [ 0, .3, .6, .9, .99 1 ]
#            keyValue [ 0 0 0, 10 10 10 , 30 30 30, 100 100 100, 500 500 500, 0 0 0 ]
            keyValue [ 0 0 0, 1 1 1 , 2 2 2, 3 3 3, 7 7 7 , 0 0 0 ]
      }

      ROUTE Colly.collideTime TO Disappeary.explode
      ROUTE Colly.collideTime TO Clippy.set_startTime
      ROUTE Touchy.touchTime TO Disappeary.explode
      ROUTE Touchy.touchTime TO Clippy.set_startTime
      ROUTE Disappeary.createMine TO MineHolder.addChildren
      ROUTE Disappeary.deleteMine TO MineHolder.removeChildren
      ROUTE Disappeary.startExplosion TO ExplosionTimer.set_startTime
      ROUTE ExplosionTimer.fraction_changed TO Plosie.set_fraction
      ROUTE Plosie.value_changed TO GreatBallOfFire.set_scale

      DEF Timey TimeSensor { cycleInterval 20 loop TRUE startTime 0 }
      DEF Rotty OrientationInterpolator {
          key [ 0.0, 0.5, 1.0 ]
          keyValue [ 1 1 1 0.0, 1 1 1 3.14, 1 1 1 6.28 ]
      }
      ROUTE Timey.fraction_changed TO Rotty.set_fraction
      ROUTE Rotty.value_changed TO MineHolder.set_rotation

} # end PROTO

Mine {}


