#VRML V2.0 utf8
#
#   Secret Lab to be excavated
#

Viewpoint {
        position 0 15 65
}

NavigationInfo {
        type FLY
        headlight TRUE
}

# ground
Transform {
        translation -20 -0.5 -30
        children [
                    Shape {
                        appearance Appearance {
               #         	material Material { emissiveColor .5 .5 0 }
                                texture ImageTexture {
#                                        url "im/lightSand.gif"
                                        url "im/plaster.jpg"
#                                        url "im/kiesel.jpg"
                                        repeatS TRUE
                                        repeatT TRUE
                                }				#        plaster   kiesel      sand
                                textureTransform TextureTransform { scale 10 10  } #25 25 }  # 50 50 
                        }
                        geometry ElevationGrid {
                                zDimension 10
                                xDimension 8
                                xSpacing 10
                                zSpacing 10
                                solid TRUE
                                creaseAngle 0.885
                                colorPerVertex TRUE
                                      texCoord TextureCoordinate {
                                          point [ 3 0, 0 0, 0 3, 3 3 ]
                                }
                                height [
                                        -20
                                        -15
                                        -10
                                        -10.2
                                        -10
                                        -10.1
                                        -15
                                        -20
                                        
                                        -15
                                         3.1
                                         3.5
                                         3
                                         3.2
                                         3.1
                                         3.5
                                        -15
                                        
                                        -10
                                         3.1
                                         5.3
                                         0.6
                                         0.4
                                         3.1
                                         4.1
                                        -10
                                        
                                        -10
                                         3
                                         0
                                         0.9
                                         0.1
                                         0.65
                                         3.1
                                        -10
                                        
                                        -10
                                         3
                                         -6
                                         -9
                                         -2
                                         0.3	#
                                         5
                                        -10
                                        
                                        -10
                                         3
                                         0.4
                                         -.8	#
                                         -1.4	#
                                         0
                                         3
                                        -10
                                        
                                        -10
                                         2.5
                                         1.8
                                         0.1
                                         0
                                         0
                                         3
                                        -10
                                        
                                        -10
                                         3
                                         5.2
                                         0
                                         0.2
                                         2.5
                                         3
                                        -10
                                        
                                        -15
                                         3
                                         3.7
                                         3.2
                                         2.8
                                         4.5
                                         3.1
                                        -15
                                        
                                        -20
                                        -15
                                        -10
                                        -10
                                        -10
                                        -10
                                        -15
                                        -20
                                ]
                        }
                     }
        ]
}

# Mine which causes the sandlayer to disappear ... ;)
EXTERNPROTO MyMine [
      eventIn SFTime explode
      eventOut SFTime exploded
] "Mine.wrl"
Transform {
        translation 3 2.3 15
        scale .4 .4 .4
        children [ 
        	DEF Miny MyMine {} 
        	DEF MineTouchy TouchSensor {}
        ]
}
ROUTE MineTouchy.touchTime TO Miny.explode

#   Sand layer
DEF SandLayer Transform {
        translation 15 2.2 15
        children [
                 Shape {
                       appearance Appearance {
                               texture ImageTexture {
                                        url "im/lightSand.gif"                                          repeatS TRUE
                                        repeatT TRUE
                               }
                               textureTransform TextureTransform { scale 50 80 }
                       }
                       geometry Box { size 48 0 70 }
                 }
                # DEF SLTouchy TouchSensor { }
        ]
}
DEF SLTimey TimeSensor { cycleInterval 1 loop FALSE startTime -1 }
DEF Lowy PositionInterpolator {
    key [ 0.0, 0.2, .5, 0.7, 1.0 ]
    keyValue [ 15 2.2 15, 15 2.2 15, 15 1.4 15, 15 .5 15, 15 -5 15 ]
}
#ROUTE SLTouchy.touchTime TO SLTimey.set_startTime
ROUTE Miny.exploded TO SLTimey.set_startTime
ROUTE SLTimey.fraction_changed TO Lowy.set_fraction
ROUTE Lowy.value_changed TO SandLayer.set_translation


# Objects:

# good ol'Bony
Transform {
        translation 2.5 1.5 -2
        scale .8 .8 .8
        children [
		Inline { url "Bony.wrl" }
	]
}

# glass column
Transform {
        translation -1 0.5 -3
        rotation 0 0 1 1.5708
        children [
            Shape {
                    appearance Appearance {
                               material Material {
                                        diffuseColor  0.4 0.6 1
                                        emissiveColor 0.2 0.4 0.9
                                        transparency 0.7
                               }
                               texture ImageTexture { url "im/niceLightBlueBG.gif" }
                    }
                    geometry Cylinder {
                             radius .15
                             height 1.5
                    }
            }
        ]
}
# glass ball
DEF Bally Transform {
        translation -2 1.5 -3
        children [
            Shape {
                    appearance Appearance {
                               material Material {
                                        diffuseColor  0.2 0.4 0.9
                                        emissiveColor 0.2 0.4 0.9
                                        transparency 0.3
                               }
                               texture ImageTexture { url "im/niceLightBlueBG.gif" }
                    }
                    geometry Sphere {
                             radius .3
                    }
            }
            DEF BallTouchy TouchSensor { }
        ]
}
DEF Timey TimeSensor { cycleInterval 10.0 loop FALSE startTime -1 }
DEF Uppy PositionInterpolator {
    key [ 0.0, 0.4, 0.6, 0.8, 1.0 ]
    keyValue [ -2 1.5 -3, -2 2  -3, -2 3  -3, -2 6 -3,  -2 30 -3 ]
}
ROUTE BallTouchy.touchTime TO Timey.set_startTime
ROUTE Timey.fraction_changed TO Uppy.set_fraction
ROUTE Uppy.value_changed TO Bally.set_translation



#
#    ROOM
#
DEF Room Transform {
rotation 1 1 0 .25
children [

# floor
DEF Floor Transform {
                  translation 0 0.15 0
                  children [
                          Shape {
                              appearance Appearance {
                                      material Material {
                                               diffuseColor 0.354 0.494 0.3965
                                               emissiveColor 0.75 0.9 0.8
                                      }
                                      texture ImageTexture { url "im/metalGrip.jpg" }
                                      textureTransform TextureTransform { scale 7 7 }
                               }
                              geometry Box {
                                       size 10 .25 10
                              }
                          }
                  ]
}

# walls
PROTO Wall [
      field SFVec3f wallSize 5 2.3 .2
]
{
   Transform {
        children [
                 Shape {
                       appearance Appearance {
                                  material Material { diffuseColor 0.9 0.5 0.5 }
                                  texture ImageTexture {
                                          url "im/shell.jpg"
                                          repeatS TRUE
                                          repeatT TRUE
                                  }
                                  textureTransform TextureTransform { scale 4 2 }
                       }
                       geometry Box { size IS wallSize }
                 }
        ]
   }
} # end PROTO Wall
