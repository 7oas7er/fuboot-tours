#VRML V2.0 utf8
#
#   Secret Lab to be excavated
#

Viewpoint {
        position 3 1 4
}

NavigationInfo {
        type [ "WALK" ]
        headlight TRUE
}

PROTO Lab [
	eventOut SFInt32 foundBony
	eventOut SFInt32 foundBottles
	eventOut SFInt32 foundBall
]
{

DEF evOut Script {
	eventIn  SFInt32 BonyIn
	eventIn  SFInt32 BottlesIn
	eventIn  SFInt32 BallIn
	eventOut SFInt32 fBon IS foundBony
	eventOut SFInt32 fBot IS foundBottles
	eventOut SFInt32 fBal IS foundBall
        directOutput TRUE
        url ["javascript:
                 function BonyIn ( b ) { fBon = b; }
                 function BottlesIn ( b ) { fBot = b; }
                 function BallIn ( b ) { fBal = b; }
        "]
}        


# Objects:
DEF EntryProximity ProximitySensor {
                        center 3.5 1.5 5
                        size 3 2.7 2
}

EXTERNPROTO Bony [
	eventIn  SFTime start 
	eventOut SFInt32 found
] "Bony.wrl#findableBony"

Transform {
        translation -2.8 .7 -2.5
        scale .5 .45 .5
        children [ DEF Bony1 Bony {} ]
}      
Transform {
        translation -3.5 .7 -2.8
        scale .5 .53 .5
        children [ DEF Bony2 Bony {} ]
}      
Transform {
        translation -2.4 .7 -3.8
        scale .5 .5 .5
        children [ DEF Bony3 Bony {} ]
}      
Transform {
        translation -3.4 .7 3.8
        scale .5 .5 .5
        children [ DEF Bony4 Bony {} ]
}      
Transform {
        translation 4.1 .7 3.2
        scale .5 .5 .5
        children [ DEF Bony5 Bony {} ]
}      
Transform {
        translation 2.7 .7 -3
        scale .5 .6 .5
        children [ DEF Bony6 Bony {} ]
}      
ROUTE EntryProximity.enterTime TO Bony1.start
ROUTE EntryProximity.enterTime TO Bony2.start
ROUTE EntryProximity.enterTime TO Bony3.start
ROUTE EntryProximity.enterTime TO Bony4.start
ROUTE EntryProximity.enterTime TO Bony5.start
ROUTE EntryProximity.enterTime TO Bony6.start

ROUTE Bony1.found TO evOut.BonyIn
ROUTE Bony2.found TO evOut.BonyIn
ROUTE Bony3.found TO evOut.BonyIn
ROUTE Bony4.found TO evOut.BonyIn
ROUTE Bony5.found TO evOut.BonyIn
ROUTE Bony6.found TO evOut.BonyIn

# Bottles
EXTERNPROTO Bot [
        field    MFString contURL
        field    SFInt32  worth      
        eventOut SFInt32  found
] "collection.wrl#Content2"
Transform {
	scale .1 .1 .1
       	translation 4.5 .3 -2.2
	children [
                  DEF Bot1 Bot {
                  	contURL "bottles.wrl"
                  	worth 250
                  }
        ]
}      
Transform {
        scale .1 .1 .1
       	translation -4.42 .3 3.5
	children [
                  DEF Bot2 Bot {
                  	contURL "bottles.wrl"
                  	worth 250
                  }
        ]
}      
Transform {
        scale .1 .1 .1
	rotation 0 1 0 1.5708
       	translation .5 .3 -4.5
	children [
                  DEF Bot3 Bot {
                  	contURL "bottles.wrl"
                  	worth 250
                  }
        ]
}      
Transform {
        scale .1 .1 .1
	rotation 0 1 0 1.5708
       	translation -.5 .3 -4.5
	children [
                  DEF Bot4 Bot {
                  	contURL "bottles.wrl"
                  	worth 250
                  }
        ]
}      
ROUTE Bot1.found TO evOut.BottlesIn
ROUTE Bot2.found TO evOut.BottlesIn
ROUTE Bot3.found TO evOut.BottlesIn
ROUTE Bot4.found TO evOut.BottlesIn

# glass ball
PROTO GlassBall [
	field SFInt32 worth 100
	eventOut SFInt32 found
] {
   DEF BallScript Script {
	eventIn  SFTime  fBall
	field    SFInt32 worth IS worth
	eventOut SFInt32 fB IS found
        directOutput TRUE
        url ["javascript:
                 function fBall ( b ) { fB = worth; }
        "]
   }        
   # column
   Transform {
        translation 0 .4 -4
        children [
            Shape {
                    appearance DEF BlueGlass Appearance {
                               material Material {
                                        diffuseColor  0.4 0.6 1
                                        emissiveColor 0.2 0.4 0.9
                                        transparency 0.3
                               }
                    }
                    geometry Cylinder {
                             radius .2
                             height .4
                    }
            }
        ]
   }
   # ball
   DEF Bally Transform {
        translation 0 1 -4
        children [
            Shape {
                    appearance USE BlueGlass
                    geometry Sphere {
                             radius .25
                    }
            }
            DEF BallTouchy TouchSensor { }
        ]
   }
   DEF Timey TimeSensor { cycleInterval 10.0 loop FALSE startTime -1 }
   DEF Uppy PositionInterpolator {
       key [ 0.0, 0.4, 0.8, 1.0 ]
       keyValue [ 0 1  -4, 0 1.5  -4, 0 2.5 -4,  0 10 -4 ]
   }
   ROUTE BallTouchy.touchTime TO Timey.set_startTime
   ROUTE BallTouchy.touchTime TO BallScript.fBall
   ROUTE Timey.fraction_changed TO Uppy.set_fraction
   ROUTE Uppy.value_changed TO Bally.set_translation
} # end Group GlassBall

Transform {
        translation -3 0 .5
        scale 1 1.3 1
        children [ DEF GB1 GlassBall {} ]
}      
Transform {
        translation 0 0 .5
        scale 1 1.3 1
        children [ DEF GB2 GlassBall {} ]
}      
Transform {
        translation 3 0 .5
        scale 1 1.3 1
        children [ DEF GB3 GlassBall {} ]
}      
Transform {
        translation -3 0 2.5
        scale 1 1.3 1
        children [ DEF GB4 GlassBall {} ]
}      
Transform {
        translation 0 0 2.5
        scale 1 1.3 1
        children [ DEF GB5 GlassBall {} ]
}      
Transform {
        translation 3 0 2.5
        scale 1 1.3 1
        children [ DEF GB6 GlassBall {} ]
}      
Transform {
        translation -3 0 4.5
        scale 1 1.3 1
        children [ DEF GB7 GlassBall {} ]
}      
Transform {
        translation 0 0 4.5
        scale 1 1.3 1
        children [ DEF GB8 GlassBall {} ]
}      
Transform {
        translation 3 0 4.5
        scale 1 1.3 1
        children [ DEF GB9 GlassBall {} ]
}      
ROUTE GB1.found TO evOut.BallIn
ROUTE GB2.found TO evOut.BallIn
ROUTE GB3.found TO evOut.BallIn
ROUTE GB4.found TO evOut.BallIn
ROUTE GB5.found TO evOut.BallIn
ROUTE GB6.found TO evOut.BallIn
ROUTE GB7.found TO evOut.BallIn
ROUTE GB8.found TO evOut.BallIn
ROUTE GB9.found TO evOut.BallIn



#
#    ROOM
#
# ceiling
Transform {
                  translation 0 2.85 0
                  children [
                          Shape {
                              appearance Appearance {
                                      material Material {
                                               # diffuseColor 0.354 0.494 0.3965
                                               emissiveColor 0.354 0.494 0.3965
                                      }
                                      texture ImageTexture { url "im/concrete.jpg" }
                                       textureTransform TextureTransform { scale 8 8 }
                               }
                              geometry Box {
                                       size 10 0 10
                              }
                          }
                  ]
}
# floor
Transform {
                  translation 0 0.2 0
                  children [
                          Shape {
                              appearance Appearance {
                                      material Material {
                                               # diffuseColor 0.354 0.494 0.3965
                                               emissiveColor 0.354 0.494 0.3965
                                      }
                                      texture ImageTexture { url "im/greenPlaster.jpg" }
                                       textureTransform TextureTransform { scale 8 8 }
                               }
                              geometry Box {
                                       size 10 0 10
                              }
                          }
                  ]
}
# showers
Transform {
        translation -1.5 1.8 4.8
        rotation 0 1 0 1.5708
        scale 1.5 1.5 1.5
        children [ Inline { url "showerhead.wrl" } ]
}      
Transform {
        translation -.5 1.8 4.8
        rotation 0 1 0 1.5708
        scale 1.5 1.5 1.5
        children [ Inline { url "showerhead.wrl" } ]
}      
Transform {
        translation .5 1.8 4.8
        rotation 0 1 0 1.5708
        scale 1.5 1.5 1.5
        children [ Inline { url "showerhead.wrl" } ]
}      
# walls
PROTO Wall [
      field SFVec3f wallSize  5 1 .5
      field SFVec2f wallScale 4 3
]
{
   Transform {
        children [
                 Shape {
                       appearance Appearance {
                                  material Material { emissiveColor 0.354 0.494 0.3965 }
                                  texture ImageTexture { url "im/tiles3D.jpg" }
                                  textureTransform TextureTransform { scale IS wallScale }
                       }
                       geometry Box { size IS wallSize }
                 }
        ]
   }
} # end PROTO Wall

DEF Wall1 Transform {
                  translation 0 1.5 -5
                  children [ Wall {
					wallSize 10.2 2.7 .2
                           		wallScale 10 3 
		  } ] 
}
DEF Wall2 Transform {
                  translation -1.1 1.5 5
                  children [ Wall {
					wallSize 8 2.7 .2
                           		wallScale 8 3 
		  } ]
}
DEF Wall3 Transform {
                  translation 4.3 1.5 5
                  children [ Wall {
					wallSize 1.1 2.7 .2
                           		wallScale 1.1 3 
		  } ]
}
DEF Walll Transform {
                  translation -5 1.5 0
                  rotation 0 1 0 1.5708
                  children [ Wall {
					wallSize 10.1 2.7 .2
                           		wallScale 10 3 
		  } ]
}
DEF Wallr Transform {
                  translation 5 1.5 0
                  rotation 0 1 0 1.5708
                  children [ Wall {
					wallSize 10.1 2.7 .2
                           		wallScale 10 3 
		  } ]
}
# side walls between showers
Transform {
	          translation -2 1.5 4.5
        	  rotation 0 1 0 1.5708
                  children [ DEF SideWall Wall {
					wallSize 1 2.7 .2
                           		wallScale 1 3 
		  } ]
}      
Transform {
	          translation -1 1.5 4.5
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      
Transform {
	          translation 0 1.5 4.5
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      
Transform {
	          translation 1 1.5 4.5
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      
# right back corner
Transform {
	          translation 4.5 1.5 -1.5
                  children [ DEF SideWall Wall {
					wallSize 1 2.7 .2
                           		wallScale 2 3 
		  } ]
}      
Transform {
	          translation 4.1 1.5 -2
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      
# left front corner
Transform {
	          translation -4.42 1.5 3
                  children [ DEF SideWall Wall {
					wallSize 1 2.7 .2
                           		wallScale 2 3 
		  } ]
}      
Transform {
	          translation -4 1.5 3.42
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      
# middle back
Transform {
	          translation 0 1.5 -4
                  children [ DEF SideWall Wall {
					wallSize 2 2.7 .2
                           		wallScale 4 3 
		  } ]
}      
Transform {
	          translation 0 1.5 -5
        	  rotation 0 1 0 1.5708
                  children [ USE SideWall ]
}      


}

Transform {
	scale 4 3 4
	children [ Lab {} ]
}



# pi/2 1.5708