#VRML V2.0 utf8

DEF Starfish Billboard { 
        axisOfRotation 1 1 0 # Rotate about Y (up) axis 
        bboxSize        1 1 1
	children [	
    	    DEF CI CoordinateInterpolator {
      		key [ 0.0, 0.5, 1.0 ]
      		keyValue [ 1 0 -1, -1 0 -1, 1 0 1, -1 0 1 ]
      		keyValue [ 1.5 0 -1.5, -1.5 0 -1.5, 1.5 0 1.5, -1.5 0 1.5 ]
      		keyValue [ 1 0 -1, -1 0 -1, 1 0 1, -1 0 1 ]
    	    }    
            Shape { 
           	appearance Appearance { 
                      texture MovieTexture { 
                      	url "im/starfish.gif"
                        loop TRUE                      	
                      }
	        } 
	        geometry Box {
        		size 1 1 0
      		}
      	    }
	]
}
