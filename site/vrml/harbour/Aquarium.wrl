#VRML V2.0 utf8
#
#   aquarium.wrl, a cave with some nice little fish turned ugly by continuing nuclear radiation ...
#

WorldInfo {
        title "FU-Boot Tours"
        info [ "by Andi" ]
}


Viewpoint {
        position 0.0 1.5 15
        orientation 0.5 0 0 0
        description "Entry view"
}

NavigationInfo {
        type [ "FLY" ]
        headlight TRUE
}



DirectionalLight {
  ambientIntensity  0.8
  color 0 0.4 .995
  direction  0 0 -1
  intensity  0.8
}




# rocky walls
Transform {
        scale 2 2 2
        translation 0 0 -10
	rotation 0 1 0 3.1428
        children [ Inline { url "Cave.wrl" } ]
}



#
#### -  ROCKS on the ground
#

### bubbles
# centre
Transform {
        translation 0.0 -1  0
        children [ Inline { url "Bubbles.wrl" } ]
}
#  right front
Transform {
        translation -7 -1 -12.5
        children [ Inline { url "Bubbles.wrl" } ]
}
Transform {
        translation -12.4 2   1.4
        children [ Inline { url "Bubbles.wrl" } ]
}
# right back
Transform {
        translation 5 -4 -20
        children [ Inline { url "Bubbles.wrl" } ]
}
# left back
Transform {
         translation 7.7 -3  -5
        children [ Inline { url "Bubbles.wrl" } ]
}
# right very back
Transform {
        translation 15 -4 -30
        children [ Inline { url "Bubbles.wrl" } ]
}
# left very back
Transform {
         translation -12.7 -3  -32
        children [ Inline { url "Bubbles.wrl" } ]
}
# left front
Transform {
        translation -5 0  3
        children [ Inline { url "Bubbles.wrl" } ]
}

### rocks
# back
Transform {
        translation -9 -3  -24
        rotation 0 .7 0 1
        children [ Inline { url "Crock.wrl" } ]
}
Transform {
        translation 5.0 -3.2  -33
        rotation 0 .3 0 1
        children [ Inline { url "Crock.wrl" } ]
}
Transform {						# right queer
        translation 12.4 -2.   2.0
        #rotation .05 .31 0 1
        children [ Inline { url "Crock.wrl" } ]
}
Transform {						# left back
        translation -12 -3 2
        rotation 0 1 1 .15
        children [ Inline { url "Crock.wrl" } ]
}
# flats:
Transform {
        translation -8.8 -3  -7.0
        rotation 0 1 0 0.8
        children [ Inline { url "CrockFlat.wrl" } ]
}
Transform {
        translation -3 -3.5   -18.0
        rotation 0 1 0 .2
        children [ Inline { url "CrockFlat.wrl" } ]
}
# right back
Transform {
        translation 17 -3.5 -24
        rotation 0 1 0 .2
        children [ Inline { url "CrockFlat.wrl" } ]
}
Transform {
        translation 23 -1.5 -33
        rotation 0 1 1 .8
        children [ Inline { url "CrockFlat.wrl" } ]
}

### Objects:

PROTO Fish [
	field SFTime   speedy 30
	field MFString fishURL [ "fish/Headfish/Manbou0.wrl" ]
	field SFVec3f  fishScale .05 .03 .17
]
{	
  DEF Fishy Transform {
        scale IS fishScale
        children [ Inline { url IS fishURL } ]
  }
  DEF Timey TimeSensor { 
  	cycleInterval IS speedy
   	loop TRUE
   	startTime 0 
  }
  DEF Rotty OrientationInterpolator {
    key [ 0, .25, .5, .75, 1 ]
    keyValue [ 0 1 0 0 , 0 1 0 1.5708, 0 1 0 3.1459, .2 1 0 4.716, 0 1 0 6.2518 ]
   }
  DEF Possy PositionInterpolator {
    key [ 0, .25, .5, .75, 1 ]
    keyValue [ 0 .5 -5, -4.5 1.5 0, 0 1 5, 4.2 -.7 0, 0 .5 -5 ]
  }
ROUTE Timey.fraction_changed TO Rotty.set_fraction
ROUTE Rotty.value_changed TO Fishy.set_rotation
ROUTE Timey.fraction_changed TO Possy.set_fraction
ROUTE Possy.value_changed TO Fishy.set_translation
}   




# a fish
Transform {
        translation -8 6 -12
        children [ Fish{} ]
}

# a fish
Transform {
        translation 6 2 -15
        rotation 0 1 0 .5
        children [ Fish { 
        	fishURL "fish/popEye/DemeKin1.wrl" 
        	speedy 23
        	fishScale .08 .09 .1
        } ]
}
# a fish
Transform {
        translation 8 6 -2
        rotation 0 1 0 1.3
        children [ Fish { speedy 47 } ]
}
# a fish
Transform {
        translation -8 3 -27
        rotation 0 1 0 2.3
        children [ Fish { 
        	fishURL "fish/popEye/DemeKin1.wrl" 
        	speedy 17
        	fishScale .08 .09 .1
        } ]
}
# a fish
Transform {
        translation -3 4.2 -17
        rotation 0 1 0 2.3
        children [ Fish { 
        	fishURL "fish/popEye/DemeKin1.wrl" 
        	speedy 34
        	fishScale .08 .09 .1
        } ]
}

# a gate
Transform {
        translation 5.6 .3 17
	scale .4 .4 .4
        children [ Inline { url "gate_tmp.wrl" } ]
}

