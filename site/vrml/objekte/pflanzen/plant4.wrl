#VRML V2.0 utf8
#
# Another nasty plant
#

Transform {
	children [
         Shape {
           	appearance Appearance { 
               	material Material { diffuseColor 1 1 1 }
           		texture ImageTexture { url "plant4.gif" } 
            }
            geometry Cone {
				height 10
            } 	
         }           
     ]
} # end Transform

