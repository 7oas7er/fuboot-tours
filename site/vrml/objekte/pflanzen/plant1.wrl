#VRML V2.0 utf8
#
# A nasty plant
#

Transform {
	children [
         Billboard {
             axisOfRotation 0.0 1.0 0.0
             children [
               	DEF Back Transform {
                   	translation 0 .3 0
                   	children [
                    	Shape {
                        	appearance Appearance { 
                	        	material Material { diffuseColor 1 1 1 }
                        		texture ImageTexture { url "plant1.gif" } 
                        	}
                        	geometry Box { size 0.5 10 0 }
                    	}
                    ]
                }           
            ]
        }
	]
} # end Transform

